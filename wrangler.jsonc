{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lending-rate",
  "main": "./dist/server/index.js",
  "compatibility_date": "2026-08-26",
  "compatibility_flags": ["nodejs_compat"],
  "account_id": "2d81e19143fcd34eaf05e18fe98a7753",
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./dist/client",
    "binding": "ASSETS",
  },
  "kv_namespaces": [
    {
      "binding": "RATES_KV",
    },
  ],
}
